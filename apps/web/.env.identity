# Cloud-identity deployment, used by `pnpm dev:identity` / `pnpm build:identity`
# (vite --mode identity). These two values are neither secret nor
# project-specific, so they are committed here.
#
# Your Supabase project URL and publishable key ARE project-specific — put them
# in `.env.identity.local` (gitignored). Copy `.env.identity.example` to start.
#
# The Discord OAuth *client secret* never goes in the app at all: set it in the
# Supabase dashboard (Authentication -> Providers -> Discord). The app never
# sees it.
VITE_IDENTITY_MODE=cloud
VITE_SUPABASE_OAUTH_PROVIDERS=discord,twitch
VITE_SYNC_MODE=supabase