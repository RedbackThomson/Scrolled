# Template for `.env.identity.local` (which is gitignored — your real values go
# there, never in a committed file). Copy this file:
#
#   cp apps/web/.env.identity.example apps/web/.env.identity.local
#
# then fill in the two values below. Find them in the Supabase dashboard under
# Project Settings -> API.
#
# IMPORTANT: the publishable key (sb_publishable_…) is a PUBLIC client key — it
# is designed to be embedded in the browser bundle, and Row Level Security (not
# key secrecy) protects your data. It is NOT a secret. The only real secret in
# this setup is the Discord OAuth client secret, and that lives in the Supabase
# dashboard, not here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY_HERE

# Enable collection and user settings sync by setting this to `supabase`.
VITE_SYNC_MODE=supabase

# Legacy alternative (still works until Supabase retires it at the end of 2026).
# Set this INSTEAD of the publishable key only if your project predates the new
# keys:
# VITE_SUPABASE_ANON_KEY=YOUR-LEGACY-ANON-KEY
