# Fixed hosted-dataset deployment, used by `pnpm dev:fixed` / `pnpm build:fixed`
# (vite --mode fixed). Values here are generic — nothing dataset-specific or
# proprietary. A real deployment overrides these (e.g. family, repo URL) via its
# own environment.
VITE_DEPLOYMENT_PROFILE=fixed-hosted-dataset
VITE_DATASET_FAMILY=local
VITE_DATASET_CHANNEL=latest
VITE_DATASET_REPO_URL=/datasets
