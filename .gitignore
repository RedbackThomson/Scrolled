# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
dist-fixed/
dist-identity/
build/
*.tsbuildinfo

# nav-graph: prepublishOnly copies the root LICENSE into the package so the
# Apache-2.0 text ships in the npm tarball. Not tracked — regenerated on every
# publish.
/packages/nav-graph/LICENSE

# Environment
.env
.env.local
.env.*.local

# Local certificates
*.crt
*.key

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test output
coverage/
.vitest-cache/

# Nix
.direnv/
result
result-*

# Proprietary / user data — NEVER commit
*.wz
*.img
/data/
/fixtures/proprietary/
*.sqlite
*.sqlite-journal

# Local hosted-dataset repository, built from your own WZ files via
# `pnpm dataset:build` and served by `pnpm dev:fixed`. Dataset artifacts are
# never part of the source.
apps/web/public/datasets/

# Local test fixtures (real WZ archives and .img dumps) — never committed. The
# README and .gitkeep inside each are the only tracked files.
packages/extractor/test/fixtures/wz/*
!packages/extractor/test/fixtures/wz/README.md
!packages/extractor/test/fixtures/wz/.gitkeep
packages/extractor/test/fixtures/img/*
!packages/extractor/test/fixtures/img/README.md
!packages/extractor/test/fixtures/img/.gitkeep
