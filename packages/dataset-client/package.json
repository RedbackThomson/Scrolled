    "lint": "eslint ."
  },
  "dependencies": {
    "@scrolled/dataset-core": "workspace:*",
    "@scrolled/dataset-repository": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "vitest": "^2.1.2"
  }
}
