{
  "name": "@scrolled/dataset-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Installs a hosted dataset: resolves it via a repository and hands the bytes to an injected sink. Decoupled from any specific storage backend.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
