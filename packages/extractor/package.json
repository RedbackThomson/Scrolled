{
  "name": "@scrolled/extractor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The write path: WZ files → typed records → game-db. Parser, extractors, and the headless dataset-build CLI. Shared by the web app's in-browser extraction and the CLI.",
  "exports": {
    ".": "./src/index.ts",
    "./parser": "./src/parser/index.ts",
    "./extractors": "./src/extractors/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dataset:build": "vite-node src/builder/cli.ts -- build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@scrolled/dataset-core": "workspace:*",
    "@scrolled/game-db": "workspace:*",
    "@scrolled/wz": "workspace:*",
    "comlink": "^4.4.2",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "vite": "^5.4.8",
    "vite-node": "^2.1.2",
    "vitest": "^2.1.2"
  }
}
