{
  "name": "@scrolled/design",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Component library for the Scrolled redesign: React components styled with CSS-variable tokens, self-hosted fonts, and a Storybook to browse them.",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/styles/tokens.css",
    "./base.css": "./src/styles/base.css",
    "./styles.css": "./src/styles/styles.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.1.0",
    "@fontsource/fredoka": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "lucide-react": "^0.451.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/manager-api": "^8.4.7",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/theming": "^8.4.7",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.4.7",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
